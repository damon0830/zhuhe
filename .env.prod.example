# ============================================================
# 珠合 (ZhuHe) 生产环境变量
# 使用方式：cp .env.prod .env.prod.local 然后修改
# ============================================================

# --- Django 安全 ---
# 生成新密钥：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-long-random-string-in-production

# --- 数据库 ---
POSTGRES_DB=zhuhe
POSTGRES_USER=zhuhe
POSTGRES_PASSWORD=change-this-database-password

# --- 域名（修改为你的域名）---
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- 可选：邮件配置（用于密码重置等）---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
